#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/modifiers.h>
#include "common.dtsi"
#include <behaviors.dtsi>


&mkp_input_listener { input-processors = <&zip_temp_layer 2 250>; };

&zip_temp_layer {
    require-prior-idle-ms = <350>;
    excluded-positions = <
        25 // A?
        26 // S?
        27 // D?
        39 // Z?
        33 // J?
        34 // K?
        35 // L?
        36 // ;?
        40 // ／?
    >;
};


// 右トラボ

&pointing_listener {
    scroller_R18 {
        layers = <18>;
        input-processors = <
            &zip_xy_scaler 1 1         // 動きを1倍（有効）に戻す
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 1 5
            &zip_scroll_y_scaler 0 3
        >;
    };

    scroller_R17 {
        layers = <17>;
        input-processors = <
            &zip_xy_scaler 1 1         // 動きを1倍（有効）に戻す
            &zip_xy_to_scroll_mapper
            &scroll_inertia_v
            &zip_scroll_x_scaler 0 3
            &zip_scroll_y_scaler 1 5
        >;
    };

    arrowball_L11 {
        status = "okay";
        layers = <11>;
        input-processors = <
            &zip_scroll_x_scaler 3 2 
            &zip_scroll_y_scaler 1 2
            &zip_keybind_keys
        >;

        process-next;
    };

    arrowball_prevent_L11 {
        layers = <11>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    sodou_torabo_L10 {
        status = "okay";
        layers = <10>;
        input-processors = <
            &zip_xy_scaler 1 1
            &zip_temp_layer 2 1500
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    sodou_torabo_L0 {
        status = "okay";
        layers = <0>;
        input-processors = <
            &zip_xy_scaler 1 1
            &zip_temp_layer 2 1500
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};

//左トラボ

&pointing_device_split_listener {
    scroller_L18 {
        layers = <18>;
        input-processors = <
            &zip_xy_scaler 1 1         // 動きを1倍（有効）に戻す
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 0 3
            &zip_scroll_y_scaler 1 5
        >;
    };

    scroller_L17 {
        layers = <17>;
        input-processors = <
            &zip_xy_scaler 1 1         // 動きを1倍（有効）に戻す
            &zip_xy_to_scroll_mapper
            &scroll_inertia_h
            &zip_scroll_x_scaler 1 5
            &zip_scroll_y_scaler 0 3
        >;
    };

    sodou_torabo_L11 {
        status = "okay";
        layers = <11>;
        input-processors = <
            &zip_xy_scaler 1 1
            &zip_temp_layer 2 1500
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;
    };

    arrowball_L10 {
        status = "okay";
        layers = <10>;
        input-processors = <
            &zip_scroll_x_scaler 3 2 
            &zip_scroll_y_scaler 1 2
            &zip_keybind_keys
        >;

        process-next;
    };

    arrowball_prevent_L10 {
        layers = <10>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    bidou_torabo_L0 {
        status = "okay";
        layers = <0>;
        input-processors = <
            &zip_xy_scaler 1 50
            &zip_temp_layer 2 1500
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};


&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
