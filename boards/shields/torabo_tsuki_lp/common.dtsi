/* config/common.dtsi */
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    zip_keybind_keys: zip_keybind_keys {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings =
            <&kp LEFT_ARROW>,
            <&kp RIGHT_ARROW>,
            <&kp DOWN_ARROW>,
            <&kp UP_ARROW>;

        tick = <10>;
        wait-ms = <0>;
        tap-ms = <0>;
        mode = <2>;
        threshold = <1>;

        // max_threshold = <200>
        // max_pending_activations = <5>
    };
};


/ {
    scroll_inertia_v17: scroll_inertia_v17 {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis      = <1>;
        layer     = <17>;
        scale     = <1>;
        scale-div = <5>;
    };
    scroll_inertia_h17: scroll_inertia_h17 {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis      = <2>;
        layer     = <17>;
        scale     = <1>;
        scale-div = <5>;
    };
    scroll_inertia_v18: scroll_inertia_v18 {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis      = <1>;
        layer     = <17>;
        scale     = <1>;
        scale-div = <5>;
    };
    scroll_inertia_h18: scroll_inertia_h18 {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis      = <2>;
        layer     = <17>;
        scale     = <1>;
        scale-div = <5>;
    };
};
