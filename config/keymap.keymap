#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "keys_ja.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 3 250>; };

&zip_temp_layer {
    require-prior-idle-ms = <350>;
    excluded-positions = <
        25 // A?
        26 // S?
        27 // D?
        28 // F?
        33 // J?
        34 // K?
        35 // L?
        36 // ;?
        38 // L-Ctrl?
        58 // L-Shift?
        59 // R-Shift?
        51 // R-Ctrl?
    >;
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_temp_layer 3 10000>;
    };
};

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&trackball_listener {
    input-processors = <
        &zip_temp_layer 3 100000
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
    >;

    scroller2 {
        layers = <1>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 0 3
            &zip_scroll_y_scaler 1 10
        >;
    };

    scroller3 {
        layers = <2>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 1 10
            &zip_scroll_y_scaler 0 3
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        BT {
            bindings = <&mo 7>;
            key-positions = <57 60>;
        };

        Esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
            slow-release;
            layers = <0>;
        };

        TEST {
            bindings = <&mo 8>;
            key-positions = <56 60>;
        };
    };

    macros {
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off 6>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    behaviors {
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans                            &trans          &trans          &trans  &trans                                                 &trans           &trans  &trans           &trans           &trans                                &trans
&none   &kp Q                             &kp W           &kp E           &kp R   &kp T                                                  &kp Y            &kp U   &kp I            &kp O            &kp P                                 &none
&none   &mt_exit_AML_on_tap LCTRL A       &mt LEFT_ALT S  &mt LEFT_GUI D  &kp F   &kp G        &trans              &trans                &kp H            &kp J   &mt RIGHT_GUI K  &mt RIGHT_ALT L  &mt_exit_AML_on_tap RCTRL KP_MINUS    &none
&none   &mt_exit_AML_on_tap LEFT_SHIFT Z  &kp X           &kp C           &kp V   &kp B        &trans              &trans                &kp N            &kp M   &kp COMMA        &kp DOT          &mt_exit_AML_on_tap RIGHT_SHIFT FSLH  &none
&none   &none                             &none           &mo 5           &mo 3   &lt 4 SPACE  &mt LANGUAGE_1 TAB  &mt LANGUAGE_2 ENTER  &lt 6 BACKSPACE  &trans  &trans           &none            &none                                 &none
            >;
        };

        L1_Yscroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L2_Xscroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L3_Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &mo 2      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 1   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };

        L4_Num {
            bindings = <
&none   &none   &none   &none   &none  &none                    &none      &none   &none   &none   &none      &none
&none   &none   &trans  &none   &none  &none                    &kp SLASH  &kp N7  &kp N8  &kp N9  &kp MINUS  &none
&none   &trans  &trans  &trans  &none  &none  &none   &none     &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp PLUS   &none
&trans  &none   &none   &none   &none  &none  &trans  &kp BSPC  &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp ENTER  &none
&trans  &none   &none   &none   &none  &none  &trans  &kp DOT   &kp N0     &none   &none   &none   &none      &none
            >;
        };

        L5_Arrow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans          &trans          &trans           &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans           &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL   &trans          &trans          &trans           &trans   &trans
            >;
        };

        L5_Func {
            bindings = <
&none   &none       &none          &none             &none        &none                        &none             &none         &none        &none         &none             &none
&none   &kp JP_SQT  &kp JP_DQUOT   &kp LS(NUMBER_1)  &kp JP_LBKT  &kp JP_RBKT                  &kp JP_YEN        &kp JP_UNDER  &none        &none         &kp LS(NUMBER_5)  &none
&none   &kp JP_AT   &kp SEMICOLON  &kp LS(NUMBER_4)  &kp JP_LPAR  &kp JP_RPAR  &none   &none   &kp LS(NUMBER_3)  &kp JP_CARET  &kp JP_AST   &kp JP_SLASH  &none             &none
&trans  &none       &kp JP_QUES    &kp JP_COLON      &kp JP_LT    &kp JP_GT    &none   &none   &kp JP_AMPS       &kp JP_EQUAL  &kp JP_PLUS  &kp JP_MINUS  &none             &trans
&trans  &none       &none          &none             &none        &none        &trans  &trans  &none             &none         &none        &none         &none             &trans
            >;
        };

        L6_BT {
            bindings = <
&none   &none   &none   &none   &none   &none                 &none         &none         &none         &none         &none         &none
&none   &none   &none   &none   &none   &none                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none  &none  &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
&trans  &none   &none   &none   &none   &none   &none  &none  &none         &none         &none         &none         &none         &trans
&trans  &none   &none   &none   &none   &none   &none  &none  &none         &trans        &trans        &none         &none         &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RGUI  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
