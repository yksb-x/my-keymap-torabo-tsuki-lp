#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "keys_ja.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 3 250>; };

&zip_temp_layer {
    require-prior-idle-ms = <350>;
    excluded-positions = <
        25 // A?
        26 // S?
        27 // D?
        39 // Z?
        33 // J?
        34 // K?
        35 // L?
        36 // ;?
        40 // ／?
    >;
};

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    zip_keybind_keys: zip_keybind_keys {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings =
            <&kp LEFT_ARROW>,   /* +X (右) に動いた時に LEFT を送る */
            <&kp RIGHT_ARROW>,  /* -X (左) に動いた時に RIGHT を送る */
            <&kp DOWN_ARROW>,   /* +Y (上) に動いた時に DOWN を送る */
            <&kp UP_ARROW>;     /* -Y (下) に動いた時に UP を送る */

        tick = <1>;
        wait-ms = <0>;
        tap-ms = <10>;

        mode = <1>;
        threshold = <1>;
        // max_threshold = <200>
        // max_pending_activations = <10>
    };
};

&pointing_listener {
    default {
        status = "okay";
        layers = <0>;
        input-processors = <
            &zip_xy_scaler 1 1
            &zip_temp_layer 3 1500
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;
    };
    arrowball {
        layers = <10>;
        input-processors = <&zip_xy_scaler 1 50>;
    };
    arrowball_prevent {
        layers = <10>;
        input-processors = <&zip_keybind_keys>;
        process-next;
    };
    scroller2 {
        layers = <1>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 0 3
            &zip_scroll_y_scaler 1 5
        >;
    };

    scroller3 {
        layers = <2>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 1 5
            &zip_scroll_y_scaler 0 3
        >;
    };
};

&pointing_device_split_listener {
    input-processors = <
        &zip_xy_scaler 1 100
        &zip_temp_layer 3 1500
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
    >;

    arrowball {
        status = "okay";
        layers = <2>;
        input-processors = <&zip_keybind_keys>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
            slow-release;
            layers = <0>;
        };

        BTclr {
            bindings = <&bt BT_CLR>;
            key-positions = <44 45>;
            layers = <8>;
        };

        x_scroll {
            bindings = <&mo 2>;
            key-positions = <35 34>;
            layers = <3 5>;
            require-prior-idle-ms = <50>;
        };

        BackSpace {
            bindings = <&kp BACKSPACE>;
            key-positions = <58 59>;
            layers = <0>;
        };

        toggle_toraboArrow {
            bindings = <&tog 10>;
            key-positions = <65 64>;
        };
    };

    macros {
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off 3>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    behaviors {
        // "hm" (Home Row Mods) という名前のカスタム挙動を作る

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;    // ① 時間：200msくらいが標準
            quick-tap-ms = <175>;       // ② 連打時の判定（任意）
            flavor = "tap-preferred";   // ★③ ここが最重要！
            bindings = <&kp>, <&kp>;
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <299>;
            quick-tap-ms = <175>;       // ② 連打時の判定（任意）
            flavor = "tap-preferred";   // ★③ ここが最重要！
        };

        ml: ml {
            compatible = "zmk,behavior-hold-tap";
            label = "ML";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hm_s: hm_s {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_S";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0_Main {
            bindings = <
&trans                  &trans                            &trans              &trans              &trans  &trans                                                &trans       &trans  &trans               &trans               &trans                                &trans
&kp LG(LC(LEFT_ARROW))  &hm LC(LEFT_SHIFT) Q              &hm LC(LEFT_ALT) W  &hm LS(LEFT_ALT) E  &kp R   &kp T                                                 &kp Y        &kp U   &hm RS(RIGHT_ALT) I  &hm RC(RIGHT_ALT) O  &hm RS(RIGHT_CONTROL) P               &kp RG(RC(RIGHT_ARROW))
&kp LA(LS(ESC))         &mt_exit_AML_on_tap LCTRL A       &hm LEFT_ALT S      &hm LEFT_GUI D      &kp F   &kp G        &trans              &trans               &kp H        &kp J   &hm RIGHT_GUI K      &hm RIGHT_ALT L      &mt_exit_AML_on_tap RCTRL MINUS       &kp RA(ESC)
&kp LC(PAGE_UP)         &mt_exit_AML_on_tap LEFT_SHIFT Z  &kp X               &kp C               &kp V   &kp B        &none               &none                &kp N        &kp M   &kp COMMA            &kp DOT              &mt_exit_AML_on_tap RIGHT_SHIFT FSLH  &kp RC(PAGE_DOWN)
&none                   &none                             &none               &trans              &trans  &lt 4 SPACE  &mt LANGUAGE_1 TAB  &mt LANGUAGE_2 BSPC  &lt 7 ENTER  &trans  &trans               &none                &none                                 &none
            >;
        };

        L1_Yscroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L2_Xscroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        L3_AML {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &none   &trans  &trans  &trans  &trans  &mkp LCLK  &ml 1 MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans     &trans  &trans
            >;
        };

        L4_Num {
            bindings = <
&none   &none   &none   &none   &none   &none                          &none            &none        &none         &none       &none      &none
&trans  &trans  &trans  &trans  &trans  &trans                         &kp N5           &kp N6       &kp N7        &kp N8      &kp N9     &trans
&trans  &trans  &trans  &mo 6   &mo 5   &mo 8   &trans         &none   &hm_s PERIOD N0  &kp N1       &kp N2        &kp N3      &kp N4     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_AL_CALC  &trans  &kp JP_EQUAL     &kp JP_PLUS  &kp JP_MINUS  &kp JP_AST  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans           &none        &none         &none       &none      &trans
            >;
        };

        L5_MML {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &ml 1 MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans      &trans     &trans  &trans
            >;
        };

        L6_Cursor {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                   &trans     &trans          &trans          &trans           &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                   &kp HOME   &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp END    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp RC(C)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RC(V)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp RC(X)  &trans          &trans          &trans           &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL  &trans     &trans          &trans          &trans           &trans     &trans
            >;
        };

        L7_Symbol {
            bindings = <
&trans  &trans        &trans         &trans            &trans               &trans                               &trans            &trans        &trans  &trans      &trans            &trans
&trans  &kp JP_SQT    &kp JP_DQUOT   &kp LS(NUMBER_1)  &kp JP_LBKT          &kp JP_RBKT                          &kp JP_YEN        &kp JP_UNDER  &none   &none       &kp LS(NUMBER_5)  &trans
&trans  &kp JP_AT     &kp SEMICOLON  &kp LS(NUMBER_4)  &hm_s JP_LT JP_LPAR  &hm_s JP_GT JP_RPAR  &trans  &trans  &kp LS(NUMBER_3)  &none         &none   &kp JP_BQT  &kp JP_TILDE      &trans
&trans  &kp JP_CARET  &kp JP_AST     &kp JP_COLON      &kp JP_LBRACE        &kp JP_RBRACE        &none   &none   &kp JP_AMPS       &kp JP_PIPE   &none   &none       &kp SLASH         &trans
&trans  &trans        &trans         &trans            &trans               &trans               &trans  &trans  &trans            &trans        &trans  &trans      &trans            &trans
            >;
        };

        L8_BTandFunc {
            bindings = <
&none   &none         &none         &none         &none         &none                                      &none         &none   &none    &none    &none    &none
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                               &kp C_MUTE    &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &trans        &trans        &trans        &trans        &trans        &none          &none         &kp C_VOL_UP  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans        &trans        &trans        &trans        &trans        &kp C_BRI_DEC  &kp C_BRI_UP  &kp C_VOL_DN  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &none          &none         &none         &none   &none    &none    &none    &trans
            >;
        };

        L9_TEST {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RGUI  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        L10_toraboArrow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
